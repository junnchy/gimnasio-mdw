# Pruebas manuales de la API. Requiere la extensión REST Client de VS Code.
@base = http://localhost:3000
# @base = https://gimnasio-mdw.vercel.app
# @cronSecret = completar-con-CRON_SECRET

# ---------------------------------------------------------------------------
# La cookie de sesión (clase 6)
# ---------------------------------------------------------------------------
# Desde la clase 6 la API pide sesión: cada request manda la cookie que Auth.js
# deja en el navegador, con la cuenta del rol que corresponde a ese endpoint
# (la matriz está en docs/api.md).
#
# LA COOKIE NO SE ESCRIBE ACÁ: es una sesión viva, y este archivo se sube al
# repositorio. Los valores se leen de `docs/.env` (está en el .gitignore):
#   1. Copiar `docs/.env.example` a `docs/.env`.
#   2. Completar SESION_SOCIO, SESION_PROFESOR y SESION_ADMIN como explica ese archivo.
#
# `{{$dotenv ...}}` lee el `.env` de la MISMA carpeta que este archivo.
#
# En producción (https) la cookie se llama `__Secure-authjs.session-token`:
# para probar contra Vercel hay que cambiar el nombre en estas tres líneas.
@sesionSocio = authjs.session-token={{$dotenv SESION_SOCIO}}
@sesionProfesor = authjs.session-token={{$dotenv SESION_PROFESOR}}
@sesionAdmin = authjs.session-token={{$dotenv SESION_ADMIN}}

###############################################################################
# CLASE 6 — los tres casos de la matriz: 401, 403 y 404
###############################################################################

### sin cookie → 401 "No autenticado"
GET {{base}}/api/reservas

### socio intentando crear un plan → 403 (el rol no alcanza, aunque el body esté bien)
POST {{base}}/api/planes
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "nombre": "Plan trucho", "precio": 1, "duracionDias": 365 }

### profesor intentando ver "mis reservas" → 403 (un profesor no tiene reservas propias)
GET {{base}}/api/reservas
Cookie: {{sesionProfesor}}

### socio cancelando una reserva AJENA → 404, no 403: no se confirma que el id existe
# Completar con el id de una reserva de otro socio (Prisma Studio, tabla Reserva,
# la de socio-vencido@ejemplo.com o la de otra cuenta de Google).
@reservaAjena = completar-con-id-de-reserva-ajena
POST {{base}}/api/reservas/{{reservaAjena}}/cancelacion
Cookie: {{sesionSocio}}

### el socioId del query NO cambia nada: se lista lo del socio de la sesión → 200
GET {{base}}/api/reservas?socioId=otro-socio
Cookie: {{sesionSocio}}

###############################################################################
# El resto del contrato, cada request con la sesión del rol que corresponde
###############################################################################

### listar planes → 200
# @name listarPlanes
GET {{base}}/api/planes?limite=50
Cookie: {{sesionAdmin}}

### límite inválido → 400
GET {{base}}/api/planes?limite=0
Cookie: {{sesionAdmin}}

### crear plan inválido → 400
POST {{base}}/api/planes
Cookie: {{sesionAdmin}}
Content-Type: application/json

{
  "nombre": "",
  "precio": -1,
  "duracionDias": 0
}

### body ausente → 400
POST {{base}}/api/planes
Cookie: {{sesionAdmin}}

### crear el mismo plan otra vez → 409
POST {{base}}/api/planes
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "nombre": "Mensual", "precio": 25000, "duracionDias": 30 }

### crear plan válido → 201 (sesión de ADMIN)
# @name crearPlan
POST {{base}}/api/planes
Cookie: {{sesionAdmin}}
Content-Type: application/json

{
  "nombre": "Mensual",
  "descripcion": "Acceso libre durante 30 días",
  "precio": 25000,
  "duracionDias": 30
}

### editar el plan recién creado → 200
PATCH {{base}}/api/planes/{{crearPlan.response.body.id}}
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "precio": 26000 }

### listar clases → 200
# @name clases
GET {{base}}/api/clases
Cookie: {{sesionSocio}}

### crear clase inválida → 400
POST {{base}}/api/clases
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "", "cupoMaximo": 0, "inicio": "no-es-fecha", "duracionMin": 0 }

### crear clase → 201
# El profesorId sale de la sesión: la clase queda asignada a quien la crea.
# @name crearClase
POST {{base}}/api/clases
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "Yoga", "cupoMaximo": 15, "inicio": "2026-12-10T18:00:00.000Z", "duracionMin": 60, "sala": "Sala 1" }

### reservar una clase → 201
# @name reserva
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "claseId": "{{clases.response.body.$[0].id}}" }

### reservar la misma clase otra vez → 409
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "claseId": "{{clases.response.body.$[0].id}}" }

### cancelar la reserva → 200
POST {{base}}/api/reservas/{{reserva.response.body.id}}/cancelacion
Cookie: {{sesionSocio}}

### marcar asistencia → 200
POST {{base}}/api/reservas/{{reserva.response.body.id}}/asistencia
Cookie: {{sesionProfesor}}

### mis visitas → 200
GET {{base}}/api/visitas
Cookie: {{sesionSocio}}

### escaneo QR inválido → 400
POST {{base}}/api/visitas/escaneos
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "qrToken": "corto" }

### escaneo QR → 201
POST {{base}}/api/visitas/escaneos
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "qrToken": "qr-fijo-de-la-puerta" }

### mi membresía → 200
GET {{base}}/api/membresias/mia
Cookie: {{sesionSocio}}

### crear membresía inválida → 400
POST {{base}}/api/membresias
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "socioId": "", "planId": "", "fechaInicio": "2026-02-01", "fechaFin": "2026-01-01" }

### registrar pago inválido → 400
POST {{base}}/api/pagos
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "membresiaId": "", "monto": -1, "fecha": "no-es-fecha", "medio": "OTRO" }

### mis rutinas → 200
# @name misRutinas
GET {{base}}/api/rutinas/mia
Cookie: {{sesionSocio}}

### crear rutina inválida → 400
POST {{base}}/api/rutinas
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "", "socioId": "" }

### cerrar visitas sin secreto → 401
# Requiere CRON_SECRET configurado en el entorno.
POST {{base}}/api/visitas/cierre-diario
# Para el camino feliz, descomentar la línea siguiente tras definir @cronSecret.
# x-cron-secret: {{cronSecret}}

### catálogo de ejercicios → 200
# @name ejercicios
GET {{base}}/api/ejercicios
Cookie: {{sesionProfesor}}

### agregar ejercicio a una rutina → 201
# @name agregarEjercicio
POST {{base}}/api/rutinas/{{misRutinas.response.body.$[0].id}}/ejercicios
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "ejercicioId": "{{ejercicios.response.body.$[0].id}}", "series": 3, "repeticiones": 10, "descansoSeg": 60, "orden": 3 }

### agregar el mismo ejercicio otra vez → 409
POST {{base}}/api/rutinas/{{misRutinas.response.body.$[0].id}}/ejercicios
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "ejercicioId": "{{ejercicios.response.body.$[0].id}}", "series": 3, "repeticiones": 10, "descansoSeg": 60, "orden": 3 }

### crear ejercicio inválido → 400
POST {{base}}/api/ejercicios
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "", "grupoMuscular": "" }

### crear ejercicio duplicado → 409
POST {{base}}/api/ejercicios
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "Sentadilla", "grupoMuscular": "Piernas" }

###############################################################################
# Clase 5 — caminos de conflicto del catálogo de errores
#
# `@qr` tiene que coincidir con QR_TOKEN de .env.local.
# Los casos marcados (*) necesitan una segunda cuenta con otro estado u otro
# rol, así que llevan instrucciones en vez de una request lista. Igual quedan
# cubiertos por los tests unitarios de `lib/*.test.ts`.
###############################################################################

@qr = qr-puerta-principal-2026

### escaneo con token corto → 400
POST {{base}}/api/visitas/escaneos
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "qrToken": "corto" }

### escaneo con token que no es el de la puerta → 409 QR_INVALIDO
POST {{base}}/api/visitas/escaneos
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "qrToken": "token-que-no-es-el-de-la-puerta" }

### escaneo válido → 201 (abre la visita) o 200 (la cierra, con duracionMin)
# @name escaneo
POST {{base}}/api/visitas/escaneos
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "qrToken": "{{qr}}" }

### repetir el escaneo dentro de los 60 segundos → 409 ESCANEO_DUPLICADO
POST {{base}}/api/visitas/escaneos
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "qrToken": "{{qr}}" }

### (*) escaneo con membresía vencida → 409 MEMBRESIA_INACTIVA
# Hace falta un socio con la membresía vencida: en Prisma Studio, ponerle a la
# membresía de esa cuenta una `fechaFin` pasada, y mandar el escaneo válido de
# arriba con su cookie. También cubierto por lib/visita.test.ts.

### cierre diario sin el secreto → 401
POST {{base}}/api/visitas/cierre-diario

### mis visitas, con duración calculada → 200
GET {{base}}/api/visitas
Cookie: {{sesionSocio}}

### reserva sin claseId → 400
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{}

### reserva de una clase que no existe → 404
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "claseId": "clase-que-no-existe" }

### clase futura para reservar
# @name claseFutura
POST {{base}}/api/clases
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "Spinning tarde", "cupoMaximo": 2, "inicio": "2027-01-10T18:00:00.000Z", "duracionMin": 60, "sala": "Principal" }

### reservar esa clase → 201
# @name reserva
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "claseId": "{{claseFutura.response.body.id}}" }

### reservarla otra vez → 409 (HORARIO_SOLAPADO y RESERVA_DUPLICADA)
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "claseId": "{{claseFutura.response.body.id}}" }

### clase sin cupo (cupoMaximo 0) → sirve para el 409 SIN_CUPO
# @name claseSinCupo
POST {{base}}/api/clases
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "Funcional lleno", "cupoMaximo": 1, "inicio": "2027-01-11T18:00:00.000Z", "duracionMin": 45, "sala": "Sala 2" }

### clase que ya pasó → sirve para CLASE_YA_INICIADA y para la asistencia
# @name clasePasada
POST {{base}}/api/clases
Cookie: {{sesionProfesor}}
Content-Type: application/json

{ "nombre": "Spinning de ayer", "cupoMaximo": 10, "inicio": "2026-01-10T18:00:00.000Z", "duracionMin": 60, "sala": "Principal" }

### reservar una clase que ya empezó → 409 CLASE_YA_INICIADA
POST {{base}}/api/reservas
Cookie: {{sesionSocio}}
Content-Type: application/json

{ "claseId": "{{clasePasada.response.body.id}}" }

### cancelar una reserva que no existe → 404
POST {{base}}/api/reservas/reserva-que-no-existe/cancelacion
Cookie: {{sesionSocio}}

### cancelar la reserva → 200
POST {{base}}/api/reservas/{{reserva.response.body.id}}/cancelacion
Cookie: {{sesionSocio}}

### cancelarla de nuevo → 409 RESERVA_NO_CONFIRMADA
POST {{base}}/api/reservas/{{reserva.response.body.id}}/cancelacion
Cookie: {{sesionSocio}}

### marcar asistencia de una clase que todavía no terminó → 409 CLASE_NO_DICTADA
POST {{base}}/api/reservas/{{reserva.response.body.id}}/asistencia
Cookie: {{sesionProfesor}}

### (*) marcar asistencia sobre la clase de otro profesor → 403
# Hace falta una segunda cuenta de PROFESOR (SEED_PROFESOR_EMAIL en el seed, o
# Prisma Studio): con su cookie en lugar de {{sesionProfesor}}, la request de
# asistencia de arriba responde 403 "La clase no es tuya".

### mi estado de cuota, con VENCIDA calculada → 200
# @name miMembresia
GET {{base}}/api/membresias/mia
Cookie: {{sesionSocio}}

### pago con monto negativo → 400
POST {{base}}/api/pagos
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "membresiaId": "{{miMembresia.response.body.id}}", "monto": -1, "fecha": "2026-09-15T12:00:00.000Z", "medio": "EFECTIVO" }

### pago sobre una membresía que no existe → 404
POST {{base}}/api/pagos
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "membresiaId": "membresia-que-no-existe", "monto": 30000, "fecha": "2026-09-15T12:00:00.000Z", "medio": "EFECTIVO" }

### pago en EFECTIVO → 201, nace APROBADO y renueva la membresía (H7)
POST {{base}}/api/pagos
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "membresiaId": "{{miMembresia.response.body.id}}", "monto": 30000, "fecha": "2026-09-15T12:00:00.000Z", "medio": "EFECTIVO" }

### pago por MP → 201, nace PENDIENTE y NO renueva (lo aprueba el webhook)
POST {{base}}/api/pagos
Cookie: {{sesionAdmin}}
Content-Type: application/json

{ "membresiaId": "{{miMembresia.response.body.id}}", "monto": 30000, "fecha": "2026-09-15T12:00:00.000Z", "medio": "MP", "refExterna": "mp-123" }
