// Modelo de datos del gimnasio (spec §3).
//
// Los nombres de campos coinciden 1:1 con los schemas de `lib/schemas/`
// (los tipos se derivan con `z.infer` y nunca se escriben a mano en paralelo).
//
// Convenciones del equipo:
// - `Socio` y `Profesor` son un mismo `User` diferenciado por su `rol`.
// - La asistencia a clase se modela como el campo `presente` de `Reserva`
//   (no hay entidad Asistencia; se fusionó en la spec).
// - Estados con enums, nunca strings sueltos.
//
// Después de cualquier cambio en este archivo:
//   npx prisma migrate dev --name <descripcion-del-cambio>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Vercel es serverless, así que hacen falta dos conexiones distintas:
  //   DATABASE_URL → el pooler, que la app usa en cada request
  //   DIRECT_URL   → la conexión directa, que usan las migraciones
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  PROFESOR
  SOCIO
}

enum EstadoMembresia {
  // Qué SÍ se guarda: son hechos que alguien realizó.
  //   ACTIVA   → resultado de registrar un pago aprobado (H7)
  //   CANCELADA → acto de cancelación
  // VENCIDA NO está acá: la membresía se vence sola cuando `fechaFin` pasa a
  // ser anterior a hoy (spec §6), sin que nadie toque el sistema. Guardarlo
  // obligaría a un proceso que recorra la tabla corrigiéndolo, y hasta que
  // corra, la columna estaría mintiendo. Se calcula al leer, como en H8.
  ACTIVA
  CANCELADA
}

enum MedioPago {
  EFECTIVO
  MP
}

enum EstadoPago {
  APROBADO
  PENDIENTE
  RECHAZADO
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}

enum EstadoVisita {
  ABIERTA
  CERRADA
  INCOMPLETA
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  nombre        String
  rol           Rol      @default(SOCIO)
  creadoEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  // Como SOCIO
  membresias Membresia[]
  rutinas    Rutina[]     @relation("RutinaSocio")
  reservas   Reserva[]
  visitas    Visita[]

  // Como PROFESOR
  rutinasCreadas Rutina[] @relation("RutinaProfesor")
  clases         Clase[]

  // Un mismo User no se borra si tiene historial (membresías, visitas,
  // reservas, rutinas, clases): Restrict protege los datos de negocio.
}

model Plan {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  // Plata: Decimal (Postgres `numeric`), no Float. En JSON serializa como
  // string; si molesta en el cliente, se pasa a centavos (Int) con un ADR.
  precio       Decimal
  duracionDias Int
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())

  membresias Membresia[]

  // Restrict: no se borra un plan que ya tiene membresías (historial de pagos).
}

model Membresia {
  id            String          @id @default(cuid())
  socioId       String
  planId        String
  fechaInicio   DateTime
  fechaFin      DateTime
  estado        EstadoMembresia @default(ACTIVA)
  creadoEn      DateTime        @default(now())
  actualizadaEn DateTime        @updatedAt

  socio User  @relation(fields: [socioId], references: [id], onDelete: Restrict)
  plan  Plan  @relation(fields: [planId], references: [id], onDelete: Restrict)
  pagos Pago[]

  @@index([socioId])
  @@index([planId])
  // Membresías que vencen (fechaFin en el pasado): la consulta que calcula
  // el estado VENCIDA de la H8 filtra por esta columna.
  @@index([fechaFin])
}

model Pago {
  id          String     @id @default(cuid())
  membresiaId String
  monto       Decimal
  fecha       DateTime
  medio       MedioPago
  estado      EstadoPago @default(PENDIENTE)
  // Referencia externa (ej. el id de la transacción en Mercado Pago).
  refExterna  String?
  creadoEn    DateTime   @default(now())

  membresia Membresia @relation(fields: [membresiaId], references: [id], onDelete: Restrict)

  // Restrict: un pago es plata, no se borra en cascada con nada.
  @@index([membresiaId])
}

model Rutina {
  id            String   @id @default(cuid())
  nombre        String
  objetivo      String?
  profesorId    String
  socioId       String
  creadoEn      DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  // Dos relaciones al mismo modelo (User): Prisma exige nombres distintos.
  profesor   User              @relation("RutinaProfesor", fields: [profesorId], references: [id], onDelete: Restrict)
  socio      User              @relation("RutinaSocio", fields: [socioId], references: [id], onDelete: Restrict)
  ejercicios RutinaEjercicio[]

  @@index([profesorId])
  @@index([socioId])
}

model Ejercicio {
  id            String  @id @default(cuid())
  nombre        String
  grupoMuscular String
  descripcion   String?
  imagenUrl     String?
  creadoEn      DateTime @default(now())

  rutinas RutinaEjercicio[]

  // El catálogo se filtra por grupo muscular: índice para no barrer la tabla.
  @@index([grupoMuscular])
}

// Entidad puente de la relación N-N Rutina <-> Ejercicio.
// Lleva los atributos propios de "un ejercicio dentro de una rutina".
model RutinaEjercicio {
  id           String   @id @default(cuid())
  rutinaId     String
  ejercicioId  String
  series       Int
  repeticiones Int
  descansoSeg  Int
  orden        Int
  creadoEn     DateTime @default(now())

  rutina    Rutina    @relation(fields: [rutinaId], references: [id], onDelete: Cascade)
  ejercicio Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Restrict)

  // Un mismo ejercicio no se repite dos veces en la misma rutina.
  @@unique([rutinaId, ejercicioId])
  @@index([ejercicioId])
}

model Clase {
  id          String   @id @default(cuid())
  nombre      String
  profesorId  String
  cupoMaximo  Int
  inicio      DateTime
  duracionMin Int
  sala        String?
  creadoEn    DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  profesor User      @relation(fields: [profesorId], references: [id], onDelete: Restrict)
  reservas Reserva[]

  @@index([profesorId])
  // El calendario se consulta por inicio (franja horaria / día).
  @@index([inicio])
}

model Reserva {
  id       String        @id @default(cuid())
  socioId  String
  claseId  String
  fecha    DateTime
  estado   EstadoReserva @default(CONFIRMADA)
  // La asistencia de la H6 se marca acá (spec: no hay entidad Asistencia).
  presente Boolean       @default(false)
  creadoEn DateTime      @default(now())
  actualizadaEn DateTime @updatedAt

  socio User  @relation(fields: [socioId], references: [id], onDelete: Restrict)
  clase Clase @relation(fields: [claseId], references: [id], onDelete: Restrict)

  // Un socio no puede reservar dos veces la misma clase (H4).
  @@unique([socioId, claseId])
  @@index([claseId])
  @@index([fecha])
}

model Visita {
  id            String       @id @default(cuid())
  socioId       String
  ingresoAt     DateTime
  egresoAt      DateTime?
  estado        EstadoVisita
  // Solo se completa cuando la visita pasa a CERRADA (spec §6).
  duracionMin   Int?
  creadoEn      DateTime     @default(now())
  actualizadaEn DateTime     @updatedAt

  socio User @relation(fields: [socioId], references: [id], onDelete: Restrict)

  @@index([socioId])
  // Reportes de ocupación por franja horaria (H3, flujo principal punto 6).
  @@index([ingresoAt])
}