# Copiar a .env.local y completar. NUNCA commitear .env.local.

# Base de datos. Las dos strings salen del botón "Connect" del panel de Supabase.
#
# DATABASE_URL: pooler en modo Transaction (puerto 6543). Es la que usa la app.
DATABASE_URL="postgresql://usuario:password@host:6543/postgres?pgbouncer=true"
#
# DIRECT_URL: conexión directa (puerto 5432). Solo la usan las migraciones.
DIRECT_URL="postgresql://usuario:password@host:5432/postgres"

# Secreto de sesión. Generar con: npx auth secret
AUTH_SECRET=""
CRON_SECRET=""

# Login con Google (clase 6). Salen de console.cloud.google.com → Google Auth
# Platform → Clientes → cliente web. URIs de redireccionamiento autorizados:
#   http://localhost:3000/api/auth/callback/google
#   https://gimnasio-mdw.vercel.app/api/auth/callback/google
# Las tres (con AUTH_SECRET) se cargan TAMBIÉN en Vercel: el .env.local no se sube.
AUTH_GOOGLE_ID=""       # termina en .apps.googleusercontent.com
AUTH_GOOGLE_SECRET=""   # empieza con GOCSPX-

# Opcional, solo para `npm run db:seed`: el mail de Google de quien tiene que
# entrar como ADMIN o PROFESOR. Quien entra por primera vez nace SOCIO.
# SEED_ADMIN_EMAIL=""
# SEED_PROFESOR_EMAIL=""

# Regla: ninguna variable con un secreto puede llamarse NEXT_PUBLIC_*,
# porque todo lo que lleva ese prefijo queda visible en el navegador.
QR_TOKEN=""
