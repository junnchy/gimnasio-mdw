# Las variables de las pruebas de punta a punta (`npm run test:e2e`).
#
# Este archivo SÍ se commitea, y es a propósito: no tiene un solo secreto.
# Todo apunta a una base local que se levanta y se tira, y los secretos de
# acá no firman ninguna sesión ni abren ninguna puerta de verdad.
#
# Lo que no puede pasar nunca es que una prueba que ESCRIBE —escanea el QR,
# reserva, carga el seed— corra contra una base que importe. Por eso
# `playwright.config.ts` y `e2e/preparar.ts` se niegan a arrancar si
# DATABASE_URL y DIRECT_URL no apuntan, las dos, a localhost y a la base
# `pulso_e2e` (e2e/base-local.ts). En localhost puede haber una base de
# desarrollo o un túnel a una remota: el nombre es lo que la marca descartable.
#
# La base se levanta con Docker, una sola vez:
#   docker run -d --name pulso-e2e -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=pulso_e2e -p 54329:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/pulso_e2e"
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/pulso_e2e"

AUTH_SECRET="secreto-de-las-pruebas-e2e-no-sirve-para-nada-mas"
# `next start` fuera de Vercel no confía en el host si no se lo dice.
AUTH_TRUST_HOST="true"
# Google no se usa: las pruebas fabrican la cookie de sesión (e2e/preparar.ts).
AUTH_GOOGLE_ID="e2e"
AUTH_GOOGLE_SECRET="e2e"

# El QR de la puerta de las pruebas. `e2e/preparar.ts` dibuja una imagen con
# este token y la prueba del flujo la sube en /escanear.
QR_TOKEN="qr-de-la-puerta-solo-pruebas-e2e"
CRON_SECRET="cron-de-las-pruebas-e2e"

# Mercado Pago no se llama en ninguna prueba: un servicio que no responde.
MP_ACCESS_TOKEN="TEST-e2e"
MP_API_URL="http://127.0.0.1:9"

# Que `.env.local` no le asigne roles a cuentas reales en la base de pruebas.
SEED_ADMIN_EMAIL=""
SEED_PROFESOR_EMAIL=""

# Que el aviso de versión nueva de Prisma no ensucie la salida de las pruebas.
PRISMA_HIDE_UPDATE_MESSAGE="1"
