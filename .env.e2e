# Las variables de las pruebas de punta a punta (`npm run test:e2e`).
#
# Este archivo SÍ se commitea, y es a propósito: no tiene un solo secreto.
# Todo apunta a una base local que se levanta y se tira, y el AUTH_SECRET de
# acá no firma ninguna sesión de verdad.
#
# Lo que no puede pasar nunca es que una prueba que ESCRIBE (reserva clases,
# registra visitas) corra contra la base de producción. Por eso
# `playwright.config.ts` se niega a arrancar si DATABASE_URL no es local.
#
# La base se levanta con Docker, una sola vez:
#   docker run -d --name pulso-e2e -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=pulso_e2e -p 54330:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:54330/pulso_e2e"
DIRECT_URL="postgresql://postgres:postgres@localhost:54330/pulso_e2e"

AUTH_SECRET="secreto-de-las-pruebas-e2e-no-sirve-para-nada-mas"
# `next start` fuera de Vercel no confía en el host si no se lo dice.
AUTH_TRUST_HOST="true"
# Google no se usa: las pruebas fabrican la cookie de sesión (e2e/sesion.ts).
AUTH_GOOGLE_ID="e2e"
AUTH_GOOGLE_SECRET="e2e"

# Valores de prueba, sin relación con los de producción.
QR_TOKEN="qr-de-las-pruebas-e2e"
CRON_SECRET="cron-de-las-pruebas-e2e"
# Una dirección que no responde: ninguna prueba cobra de verdad.
MP_ACCESS_TOKEN="TEST-e2e"
MP_API_URL="http://127.0.0.1:9"

PRISMA_HIDE_UPDATE_MESSAGE="1"
